{
  "name": "tpe-playground",
  "version": "1.0.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test && npm run build",
    "bench:model": "vite build --ssr benchmarks/modelTwoParam.ts --outDir node_modules/.cache/tpe-model-benchmark && node node_modules/.cache/tpe-model-benchmark/modelTwoParam.js",
    "bench:browser": "vite build --config benchmarks/vite.config.ts && vite preview --config benchmarks/vite.config.ts --host 127.0.0.1 --port 4173 --strictPort"
  },
  "dependencies": {
    "katex": "^0.19.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/katex": "^0.16.8",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
